{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "corepack pnpm install",
  "buildCommand": "corepack pnpm build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api$|api/).*)",
      "destination": "/index.html"
    }
  ]
}
