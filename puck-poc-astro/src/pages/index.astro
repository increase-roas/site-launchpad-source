---
import "@puck-poc/blocks.css";
import { PuckPageRender } from "@puck-poc/PuckPageRender.tsx";
import { SAMPLE_PUCK_DATA } from "@puck-poc/sampleData.ts";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Puck PoC · Astro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        margin: 0;
        background: #f1f5f9;
        font-family: Manrope, ui-sans-serif, system-ui, sans-serif;
      }
      .astro-frame {
        padding: 24px;
      }
      .astro-label {
        margin: 0 0 16px;
        color: #64748b;
        font-size: 12px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
    </style>
  </head>
  <body>
    <main class="astro-frame">
      <p class="astro-label">Astro + @astrojs/react · same Puck blocks · sample JSON</p>
      <PuckPageRender data={SAMPLE_PUCK_DATA} />
    </main>
  </body>
</html>
